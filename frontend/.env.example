# Frontend environment configuration.
# Copy this file to .env.local and fill in values. Do NOT commit .env.local.

# Base URL for the FastAPI backend. Used by the Vite dev proxy.
VITE_BACKEND_URL=http://127.0.0.1:8000

# WebSocket URL for the FastAPI backend. Used by the Vite dev proxy.
VITE_BACKEND_WS_URL=ws://127.0.0.1:8000
