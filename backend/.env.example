# ====================================================================
# AERIS backend environment configuration.
# Copy this file to .env and fill in real values. DO NOT commit .env.
# ====================================================================

# --- Application ---
APP_NAME=AERIS
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=False
API_V1_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CSRF_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
# Comma-separated origin allowlist. NEVER use *.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_DOMAIN=localhost
SECURE_COOKIES=False
# Set to True in production to disable /api/docs
ENABLE_SWAGGER=True

# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=aeris

# --- External APIs ---
# Mappls: https://www.mappls.com/api-sdk
MAPPLS_API_KEY=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
# Firebase Admin SDK JSON file path
FIREBASE_CREDENTIALS_PATH=
# FCM legacy server key (or use firebase-admin instead)
FCM_SERVER_KEY=

# --- Rate limiting / Cache ---
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_REPORTS=20/minute

# --- File uploads ---
MAX_UPLOAD_BYTES=5242880
ALLOWED_UPLOAD_MIMES=image/jpeg,image/png,image/webp
